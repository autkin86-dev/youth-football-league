{
  "tests": [
    {
      "name": "Получение данных первенства",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Неверный пароль",
      "method": "POST",
      "path": "/?action=login",
      "body": {"password": "wrong-password-000"},
      "expectedStatus": 401
    },
    {
      "name": "Заявка с пустыми полями отклоняется",
      "method": "POST",
      "path": "/?action=apply",
      "body": {"team_name": "", "coach": "", "phone": ""},
      "expectedStatus": 400
    },
    {
      "name": "Вход тренера с неверными данными",
      "method": "POST",
      "path": "/?action=coach_login",
      "body": {"login": "nobody", "password": "wrong-000"},
      "expectedStatus": 401
    },
    {
      "name": "Создание тренера без прав админа",
      "method": "POST",
      "path": "/?action=save_coach",
      "body": {"login": "hacker", "team": "Тест", "password": "1234"},
      "expectedStatus": 403
    },
    {
      "name": "Список заявок без токена запрещён",
      "method": "GET",
      "path": "/?action=applications",
      "expectedStatus": 403
    },
    {
      "name": "Сохранение без токена запрещено",
      "method": "POST",
      "path": "/?action=save_match",
      "body": {"id": 1, "home_goals": 1, "away_goals": 1},
      "expectedStatus": 403
    },
    {
      "name": "Заявка на перенос без входа тренера запрещена",
      "method": "POST",
      "path": "/?action=reschedule_request",
      "body": {"match_id": 1, "new_date": "2026-09-20"},
      "expectedStatus": 403
    },
    {
      "name": "Смена статуса переноса без прав админа",
      "method": "POST",
      "path": "/?action=reschedule_status",
      "body": {"id": 1, "status": "approved"},
      "expectedStatus": 403
    }
  ]
}